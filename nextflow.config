// Skeleton only. Fill in when the first module exists (Phase 1).
// $HOME does not expand here: use System.getenv('HOME').
params {
    outdir  = "${System.getenv('HOME')}/projects/metagenomics_1_Nanopore/results"
    datadir = "${System.getenv('HOME')}/projects/metagenomics_1_Nanopore/data"
}
executor {
    cpus   = 4
    memory = '8 GB'      // WSL is capped at 12 GB; leave headroom
}
profiles {
    docker      { docker.enabled = true }
    singularity { singularity.enabled = true; singularity.autoMounts = true }
}
