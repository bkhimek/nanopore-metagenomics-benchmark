// Core benchmark workflow. Defaults reproduce the frozen dev baseline (PlusPF-8, confidence 0.0, threshold fraction 0.0008, D14b).
manifest {
    name = 'nanopore-metagenomics-benchmark'
    description = 'Kraken2 classification and scoring of the D6331 mock pools (research use only, not clinically validated)'
    mainScript = 'main.nf'
    nextflowVersion = '>=24.10.0'
}
params {
    pool           = 'dev'
    allow_eval     = false          // the evaluation pool needs this flag, as in bin/03, bin/04 and bin/06
    datadir        = "${projectDir}/data"
    outdir         = "${projectDir}/results"   // gitignored; scored copies are NOT the registered reports
    reads          = null           // override the pool file named in the manifest
    manifest       = "${projectDir}/data/subsets/SRR31222153.seed20261012.sra_blocks.manifest.json"
    db             = "${projectDir}/data/db/pluspf_08_20260626"
    db_name        = 'data/db/pluspf_08_20260626'   // recorded in run.json; bin/04 reads nodes.dmp from this path
    db_archive_md5 = '79a153b99f045bc2ae95e6d57c17a02d'
    truth          = "${projectDir}/reference/d6331_expected_reads_by_species.csv"
    aliases        = "${projectDir}/reference/d6331_taxid_aliases.csv"
    arms           = '0.0'          // comma list of Kraken2 --confidence values, e.g. '0.0,0.05,0.1,0.2,0.4'
    min_frac       = '0.0008'       // detection threshold as a fraction of all reads (D14b)
    bootstrap      = 1000
    classified_dir = null           // skip classification and score an existing run folder
    threads        = 6
    memory         = '10 GB'        // WSL is capped at 12 GB
    kraken2_image  = 'quay.io/biocontainers/kraken2@sha256:db5d772d9df323cf0ddc644fb9793c0fca25b61f86469be42f1a9f5b903b9fdf'
    python_image   = 'docker.io/library/python:3.12.7-slim'   // pinned by tag; pin the digest after the first run (docker inspect)
}
profiles {
    standard    { docker.enabled = true }
    docker      { docker.enabled = true }
    singularity { singularity.enabled = true; singularity.autoMounts = true }
    local       { docker.enabled = false }   // tools on PATH (tests; python3 with the standard library)
    test {
        docker.enabled = false
        params.manifest       = "${projectDir}/tests/fixtures/fixture.sra_blocks.manifest.json"
        params.db             = "${projectDir}/tests/fixtures/db"
        params.db_name        = 'data/db/fixture_db'
        params.truth          = "${projectDir}/tests/fixtures/truth.csv"
        params.aliases        = "${projectDir}/tests/fixtures/aliases.csv"
        params.classified_dir = "${projectDir}/tests/fixtures/classify/dev/baseline_c0"
        params.min_frac       = '0.01'
        params.bootstrap      = 200
        params.outdir         = "${projectDir}/results_test"
    }
}
process { errorStrategy = 'terminate' }
